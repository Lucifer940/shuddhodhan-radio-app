# Copy this file to keystore.properties and fill in your real passwords
# keystore.properties is gitignored for security
# Place your upload keystore at app/upload-keystore.jks (or any path)

storeFile=app/upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD

# For Play App Signing, you only need upload keystore.
# Google will manage the final distribution signing key.
